<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="16dp">

    <!-- Заголовок магазина -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Магазин"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Ваши очки -->
    <TextView
        android:id="@+id/current_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="У вас: 0 очков"
        android:textSize="18sp"
        android:textColor="@color/success_color"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Разделитель -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp" />

    <!-- В TabLayout добавляем третью вкладку -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Theme.Clicker.Light.TabLayout"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        android:layout_marginBottom="8dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Флаги" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Прокачка" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Энергия" />

    </com.google.android.material.tabs.TabLayout>

    <!-- ViewPager2 для содержимого вкладок -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/shop_viewpager"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginBottom="16dp" />

    <!-- Кнопка закрытия -->
    <Button
        android:id="@+id/close_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Закрыть"
        android:textColor="@color/text_primary"
        android:backgroundTint="@color/accent_color"
        android:textAllCaps="false"
        android:paddingVertical="12dp" />

</LinearLayout>